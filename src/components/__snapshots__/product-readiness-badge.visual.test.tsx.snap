exports[`ProductReadinessBadge — regressão visual (DOM snapshot) > estado pendente @ desktop (1440x900) > pending-desktop-trigger 1`] = `"<span role="button" tabindex="0" aria-label="Prontidão para produção: 2 de 4 gates críticos pendentes: Ficha técnica aprovada, Custo definido." class="inline-flex items-center gap-1 rounded-full border px-1.5 py-0.5 text-[10px] font-medium tabular-nums cursor-help focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 border-amber-500/30 bg-amber-500/10 text-amber-700 dark:text-amber-400" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-alert size-3" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="M12 8v4"></path><path d="M12 16h.01"></path></svg><span aria-hidden="true">2/4</span></span>"`;

exports[`ProductReadinessBadge — regressão visual (DOM snapshot) > estado pendente @ desktop — tooltip aberto > pending-desktop-tooltip 1`] = `"<div data-side="top" data-align="center" data-state="instant-open" class="z-50 rounded-md bg-primary text-xs text-primary-foreground animate-in fade-in-0 zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 origin-(--radix-tooltip-content-transform-origin) max-w-xs p-0 overflow-hidden" role="tooltip" style="__style__"><div class="px-3 py-2 border-b border-border/50 bg-muted/40"><div class="text-[11px] font-semibold">Gates críticos pendentes</div><div class="text-[10px] text-muted-foreground mt-0.5">2 de 4 gate(s) crítico(s) ainda travam a produção.</div></div><ul class="p-2 space-y-1.5"><li class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x size-3 mt-0.5 text-amber-500 shrink-0" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="sr-only">Pendente:</span><div class="min-w-0"><div class="text-[11px] font-medium leading-tight">Ficha técnica aprovada</div><div class="text-[10px] text-muted-foreground leading-snug">sem versão aprovada</div></div></li><li class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-3 mt-0.5 text-emerald-500 shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="sr-only">Aprovado:</span><div class="min-w-0"><div class="text-[11px] font-medium leading-tight">BOM (materiais)</div><div class="text-[10px] text-muted-foreground leading-snug">A lista de materiais (BOM) precisa ter pelo menos 1 item com consumo definido — sem BOM não há MRP nem custo real.</div></div></li><li class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x size-3 mt-0.5 text-amber-500 shrink-0" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="sr-only">Pendente:</span><div class="min-w-0"><div class="text-[11px] font-medium leading-tight">Custo definido</div><div class="text-[10px] text-muted-foreground leading-snug">O produto precisa de custo calculado (materiais + processo). Sem custo o comercial não precifica e o PCP não libera OP.</div></div></li><li class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-3 mt-0.5 text-emerald-500 shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="sr-only">Aprovado:</span><div class="min-w-0"><div class="text-[11px] font-medium leading-tight">Protótipo aprovado</div><div class="text-[10px] text-muted-foreground leading-snug">Ao menos uma peça piloto precisa estar aprovada — garante que o produto foi provado, medido e liberado antes de escalar.</div></div></li></ul><span id="__id__" role="tooltip" style="__style__"><div class="px-3 py-2 border-b border-border/50 bg-muted/40"><div class="text-[11px] font-semibold">Gates críticos pendentes</div><div class="text-[10px] text-muted-foreground mt-0.5">2 de 4 gate(s) crítico(s) ainda travam a produção.</div></div><ul class="p-2 space-y-1.5"><li class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x size-3 mt-0.5 text-amber-500 shrink-0" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="sr-only">Pendente:</span><div class="min-w-0"><div class="text-[11px] font-medium leading-tight">Ficha técnica aprovada</div><div class="text-[10px] text-muted-foreground leading-snug">sem versão aprovada</div></div></li><li class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-3 mt-0.5 text-emerald-500 shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="sr-only">Aprovado:</span><div class="min-w-0"><div class="text-[11px] font-medium leading-tight">BOM (materiais)</div><div class="text-[10px] text-muted-foreground leading-snug">A lista de materiais (BOM) precisa ter pelo menos 1 item com consumo definido — sem BOM não há MRP nem custo real.</div></div></li><li class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x size-3 mt-0.5 text-amber-500 shrink-0" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="sr-only">Pendente:</span><div class="min-w-0"><div class="text-[11px] font-medium leading-tight">Custo definido</div><div class="text-[10px] text-muted-foreground leading-snug">O produto precisa de custo calculado (materiais + processo). Sem custo o comercial não precifica e o PCP não libera OP.</div></div></li><li class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-3 mt-0.5 text-emerald-500 shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="sr-only">Aprovado:</span><div class="min-w-0"><div class="text-[11px] font-medium leading-tight">Protótipo aprovado</div><div class="text-[10px] text-muted-foreground leading-snug">Ao menos uma peça piloto precisa estar aprovada — garante que o produto foi provado, medido e liberado antes de escalar.</div></div></li></ul></span></div>"`;

